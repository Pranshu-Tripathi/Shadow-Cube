DISCORD_TOKEN=your_discord_bot_token_here
# Which repo each channel works on is set at runtime with `!project -name <name> -path <path>`.
# Optional: root directory that holds all worktrees, as <WORKTREES_DIR>/<project-name>/<channel-name>
# (default: /Users/tripathi/Desktop/development/code/worktrees)
# WORKTREES_DIR=/absolute/path/to/worktrees
# Optional: directory whose immediate Git-repository children appear in the project picker
# PROJECTS_ROOT=/absolute/path/to/projects
# Optional: local Ollama model used for conversation titles (defaults to VOICE_CLEANUP_MODEL)
# TITLE_MODEL=gemma3:1b
# Optional: branch name prefix (default: shadow-cube). Set to empty string for no prefix.
# BRANCH_PREFIX=shadow-cube
# Optional: GitHub PAT for `!repo` reads (required for private rules repos)
# GITHUB_PAT=github_pat_xxx

# --- Voice messages (run `bun run setup:voice` first) ---
# Optional: seconds/bytes a clip may be before it is rejected (defaults: 600s, 25MB)
# VOICE_MAX_DURATION_SEC=600
# VOICE_MAX_BYTES=26214400
# Optional: how long the transcript card waits before auto-sending (default: 15000)
# VOICE_AUTO_SEND_MS=15000
# Optional: whisper.cpp binary, model and language
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin
# WHISPER_LANGUAGE=en
# FFMPEG_BIN=ffmpeg
# Optional: local ollama model that proof-reads the transcript (default: gemma3:1b).
# Set to an empty string to send the raw whisper output instead.
# VOICE_CLEANUP_MODEL=gemma3:1b
# VOICE_CLEANUP_KEEP_ALIVE=30m
# OLLAMA_HOST=http://127.0.0.1:11434
