DISCORD_TOKEN=your_discord_bot_token_here
# Which repo each channel works on is set at runtime with `!project -name <name> -path <path>`.
# Optional: root directory that holds all worktrees, as <WORKTREES_DIR>/<project-name>/<channel-name>
# (default: /Users/tripathi/Desktop/development/code/worktrees)
# WORKTREES_DIR=/absolute/path/to/worktrees
# Optional: branch name prefix (default: shadow-cube). Set to empty string for no prefix.
# BRANCH_PREFIX=shadow-cube
# Optional: GitHub PAT for `!repo` reads (required for private rules repos)
# GITHUB_PAT=github_pat_xxx
